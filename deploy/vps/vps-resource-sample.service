[Unit]
Description=Lightweight per-project resource accounting snapshot

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/vps-resource-sample.py
StateDirectory=vps-resource-samples
StateDirectoryMode=0700
UMask=0077
CPUQuota=10%
MemoryMax=64M
Nice=15
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
