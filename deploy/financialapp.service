[Unit]
Description=SelfMoney FinancialApp
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=financialapp
Group=financialapp
WorkingDirectory=/srv/financialapp/releases/current
EnvironmentFile=/etc/financialapp/app.env
ExecStart=/usr/bin/node FinancialApp.js
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/financialapp/shared
MemoryMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
